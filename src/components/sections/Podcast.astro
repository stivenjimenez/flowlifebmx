---
import { episodios, miniaturaEpisodio, podcast, urlEpisodio } from '../../data/podcast';
---

<section id="podcast">
  <div class="fl-inner">
    <div class="fl-kicker">07 / PODCAST</div>
    <div class="cabecera">
      <div class="marca">
        <div class="logoCaja">
          <img src={podcast.logo} alt={podcast.nombre} class="logo" width="900" height="900" loading="lazy" decoding="async" />
        </div>
        <div class="creditos">
          <span class="creditosEtiqueta">HECHO Y PRESENTADO POR</span>
          <span class="creditosMarcas">
            {
              podcast.creditos.map((credito) => (
                <span class:list={['creditoMarca', { propia: credito.propia }]}>{credito.nombre}</span>
              ))
            }
          </span>
        </div>
        <div class="redes">
          {
            podcast.redes.map((red) => (
              <a href={red.href} target="_blank" rel="noopener noreferrer">
                {red.label}
              </a>
            ))
          }
        </div>
      </div>
      <div class="intro">
        <h2 class="fl-title titulo">Ruedelo<br />Podcast.</h2>
        <p class="bajada">El podcast del BMX freestyle de Medellín, hecho por los que ruedan.</p>
        {podcast.descripcion.map((parrafo) => <p class="texto">{parrafo}</p>)}
        <a href={podcast.capitulos} class="cta" target="_blank" rel="noopener noreferrer">Ver todos los capítulos →</a>
      </div>
    </div>

    <div class="capitulos">
      <div class="capitulosCabecera">
        <h3 class="capitulosTitulo">Capítulos más vistos</h3>
        <a href={podcast.capitulos} class="verTodos" target="_blank" rel="noopener noreferrer">Ver el canal →</a>
      </div>
      <div class="grid">
        {
          episodios.map((ep, i) => (
            <a class="capitulo" href={urlEpisodio(ep.id)} target="_blank" rel="noopener noreferrer">
              <div class="miniatura">
                <img
                  src={miniaturaEpisodio(ep.id, 'mqdefault')}
                  srcset={`${miniaturaEpisodio(ep.id, 'mqdefault')} 320w, ${miniaturaEpisodio(ep.id, 'maxresdefault')} 1280w`}
                  sizes={
                    /* el primer capítulo ocupa el doble de ancho en escritorio */
                    i === 0 ? '(max-width: 639px) 100vw, 50vw' : '(max-width: 639px) 100vw, (max-width: 1039px) 50vw, 25vw'
                  }
                  alt={`Miniatura del capítulo ${ep.episodio} con ${ep.invitado}`}
                  width="1280"
                  height="720"
                  loading="lazy"
                  decoding="async"
                />
                <span class="badge">{ep.episodio}</span>
                <span class="play" aria-hidden="true">
                  ▶
                </span>
              </div>
              <div class="info">
                <h4 class="invitado">{ep.invitado}</h4>
                <p class="episodioBajada">{ep.bajada}</p>
                <span class="ver">Ver en YouTube →</span>
              </div>
            </a>
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  section {
    border-bottom: 1px solid var(--border);
  }
  .cabecera {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: clamp(32px, 5vw, 56px);
    align-items: start;
    margin-bottom: clamp(48px, 6vw, 72px);
  }

  /* Marca del podcast */
  .marca {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  .logoCaja {
    background: var(--surface);
    border: 1px solid var(--border);
    aspect-ratio: 1/1;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: clamp(20px, 4vw, 36px);
    /* Aísla el mix-blend-mode del logo para que solo se mezcle con esta caja */
    isolation: isolate;
  }
  /* El logo original es negro sobre blanco: se invierte a blanco y el `screen`
     hace transparente el fondo ya negro, sin necesidad de un PNG recortado. */
  .logo {
    width: 100%;
    height: auto;
    filter: invert(1) contrast(1.2);
    mix-blend-mode: screen;
  }
  .creditos {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .creditosEtiqueta {
    font-family: var(--font-mono);
    font-size: 10px;
    color: var(--muted-dim);
    letter-spacing: 0.12em;
  }
  .creditosMarcas {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .creditoMarca {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--text);
    border: 1px solid var(--border-strong);
    padding: 6px 12px;
  }
  .creditoMarca.propia {
    color: var(--acc);
    border-color: var(--acc);
  }
  .redes {
    display: flex;
    flex-direction: column;
    gap: 10px;
    font-family: var(--font-mono);
    font-size: 13px;
  }
  .redes a {
    color: var(--muted);
    text-decoration: none;
  }
  .redes a:hover {
    color: var(--acc);
  }

  /* Texto de presentación */
  h2.titulo {
    margin-bottom: 12px;
  }
  .bajada {
    font-size: 16px;
    color: var(--text);
    max-width: 560px;
    margin: 0 0 24px;
  }
  .texto {
    font-size: 15px;
    line-height: 1.7;
    color: var(--muted);
    max-width: 620px;
    margin: 0 0 14px;
  }
  .cta {
    display: inline-flex;
    align-items: center;
    background: var(--acc);
    color: var(--accInk);
    text-decoration: none;
    font-size: 13px;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 15px 26px;
    border-radius: 3px;
    margin-top: 18px;
  }
  .cta:hover {
    filter: brightness(1.1);
  }

  /* Capítulos destacados */
  .capitulosCabecera {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 24px;
  }
  .capitulosTitulo {
    font-family: var(--font-display);
    font-size: clamp(28px, 3vw, 38px);
    line-height: 1;
    margin: 0;
  }
  .verTodos {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--acc);
    text-decoration: none;
  }
  .verTodos:hover {
    text-decoration: underline;
  }
  .grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 16px;
  }
  .capitulo {
    background: var(--surface);
    border: 1px solid var(--border);
    text-decoration: none;
    color: inherit;
    display: flex;
    flex-direction: column;
  }
  .capitulo:hover,
  .capitulo:focus-visible {
    border-color: var(--acc);
  }
  .capitulo:focus-visible {
    outline: 2px solid var(--acc);
    outline-offset: 2px;
  }
  .miniatura {
    position: relative;
    aspect-ratio: 16/9;
    background: repeating-linear-gradient(135deg, #181818 0 14px, #131313 14px 28px);
    border-bottom: 1px solid var(--border);
    overflow: hidden;
  }
  .miniatura img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .badge {
    position: absolute;
    top: 10px;
    left: 10px;
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 700;
    color: var(--accInk);
    background: var(--acc);
    padding: 3px 8px;
  }
  .play {
    position: absolute;
    right: 10px;
    bottom: 10px;
    width: 34px;
    height: 34px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 12px;
    color: var(--text);
    background: rgba(11, 11, 11, 0.72);
    border: 1px solid var(--border-strong);
    border-radius: 50%;
  }
  .capitulo:hover .play {
    background: var(--acc);
    color: var(--accInk);
    border-color: var(--acc);
  }
  .info {
    padding: 16px 18px 18px;
    display: flex;
    flex-direction: column;
    gap: 8px;
    flex: 1;
  }
  .invitado {
    font-family: var(--font-display);
    font-size: 24px;
    line-height: 1;
    margin: 0;
  }
  .episodioBajada {
    font-size: 13px;
    line-height: 1.6;
    color: var(--muted);
    margin: 0;
    flex: 1;
  }
  .ver {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--acc);
  }

  @media (min-width: 640px) {
    .grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1040px) {
    .grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
    /* El capítulo más visto ocupa un bloque 2×2: con 5 capítulos la grilla
       queda exacta y con otro número simplemente sigue el flujo normal. */
    .capitulo:first-child {
      grid-column: span 2;
      grid-row: span 2;
    }
    .capitulo:first-child .invitado {
      font-size: 34px;
    }
    .capitulo:first-child .episodioBajada {
      font-size: 15px;
    }
    .capitulo:first-child .info {
      padding: 22px 24px 24px;
    }
  }

  @media (max-width: 859px) {
    .cabecera {
      grid-template-columns: minmax(0, 1fr);
    }
    .marca {
      max-width: 420px;
    }
  }
</style>
