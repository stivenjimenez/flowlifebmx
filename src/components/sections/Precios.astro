---
import { planes } from '../../data/planes';
---

<section id="precios">
  <div class="fl-inner">
    <div class="fl-kicker">05 / PRECIOS</div>
    <h2 class="fl-title titulo">Elige cómo<br />quieres progresar.</h2>
    <div class="grid">
      {
        planes.map((plan, index) => (
          <article class="card">
            <div class="encabezado">
              <h3 class="nombre">{plan.nombre}</h3>
              <span class="indice" aria-hidden="true">{String(index + 1).padStart(2, '0')} / {String(planes.length).padStart(2, '0')}</span>
            </div>
            <div class="precio">{plan.precio}</div>
            <div class="unidad">POR CLASE</div>
            <ul class="incluye">
              {plan.incluye.map((item) => (
                <li><span class="flecha" aria-hidden="true">↗</span>{item}</li>
              ))}
            </ul>
            <a href="#contacto" class="btn">Reservar clase ↗</a>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  section { border-bottom: 1px solid var(--border); }
  h2.titulo { margin-bottom: 34px; }
  .grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 20px; }
  .card { background: var(--surface); border: 1px solid var(--border); padding: 30px; display: flex; flex-direction: column; }
  .encabezado { display: flex; justify-content: space-between; align-items: start; gap: 15px; }
  .nombre { font-family: var(--font-display); font-size: 34px; font-weight: 400; line-height: 1; margin: 0; }
  .indice { color: var(--acc); font-family: var(--font-mono); font-size: 12px; white-space: nowrap; }
  .precio { color: var(--acc); font-family: var(--font-display); font-size: 52px; line-height: 1; margin: 28px 0 4px; }
  .unidad { color: var(--muted); font-family: var(--font-mono); font-size: 10px; letter-spacing: 0.05em; }
  .incluye { list-style: none; border-top: 1px solid var(--border); padding: 12px 0 0; margin: 26px 0; flex: 1; color: var(--muted); font-size: 13px; line-height: 1.6; }
  .incluye li { display: flex; gap: 12px; margin: 11px 0; }
  .flecha { color: var(--acc); }
  .btn { text-align: center; text-decoration: none; font-size: 11px; font-weight: 800; letter-spacing: 0.1em; text-transform: uppercase; padding: 15px; color: var(--text); border: 1px solid var(--border-strong); }
  .btn:hover { border-color: var(--acc); color: var(--acc); }
  @media (max-width: 650px) { .grid { grid-template-columns: 1fr; } .card { padding: 24px; } }
</style>
