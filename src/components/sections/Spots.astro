---
import { spots } from '../../data/spots';
const mapaUrl = (ubicacion: string) => `https://maps.google.com/maps?q=${encodeURIComponent(ubicacion)}&z=16&output=embed`;
const rutaUrl = (ubicacion: string) => `https://www.google.com/maps/dir/?api=1&destination=${encodeURIComponent(ubicacion)}`;
---

<section id="spots">
  <div class="fl-inner">
    <div class="fl-kicker">SPOTS Y SKATEPARKS</div>
    <h2 class="fl-title titulo">Dónde<br />andamos.</h2>
    <div class="grid">
      <div class="mapa">
        <div class="mapa-marco"><iframe src={mapaUrl(spots[0].ubicacion)} title={`Mapa de ${spots[0].nombre}`} loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe></div>
        <div class="mapa-pie"><span class="preview-nombre">{spots[0].nombre}</span><a class="ruta" href={rutaUrl(spots[0].ubicacion)} target="_blank" rel="noopener noreferrer">CÓMO LLEGAR ↗</a></div>
      </div>
      <div class="cards">
        {
          spots.map((spot, index) => (
            <button class="card selector" type="button" aria-pressed={index === 0 ? 'true' : 'false'} data-ubicacion={spot.ubicacion} data-nombre={spot.nombre} data-mapa={spot.mapa} data-ruta={spot.ruta}>
              <span class="cabecera"><span class="nombre">{spot.nombre}</span><span aria-hidden="true">↗</span></span>
              <span class="ideal">{spot.descripcion}</span>
            </button>
          ))
        }
      </div>
    </div>
  </div>
</section>

<script>
  const section = document.querySelector('#spots');
  const map = section?.querySelector<HTMLIFrameElement>('.mapa iframe');
  const name = section?.querySelector('.preview-nombre');
  const route = section?.querySelector<HTMLAnchorElement>('.ruta');
  const buttons = section?.querySelectorAll<HTMLButtonElement>('.selector');

  buttons?.forEach((button) => button.addEventListener('click', () => {
    if (!map || !name || !route || !button.dataset.nombre || !button.dataset.ubicacion) return;
    const location = encodeURIComponent(button.dataset.ubicacion);
    map.src = button.dataset.mapa || `https://maps.google.com/maps?q=${location}&z=16&output=embed`;
    map.title = `Mapa de ${button.dataset.nombre}`;
    name.textContent = button.dataset.nombre;
    route.href = button.dataset.ruta || `https://www.google.com/maps/dir/?api=1&destination=${location}`;
    buttons.forEach((item) => item.setAttribute('aria-pressed', String(item === button)));
  }));
</script>

<style>
  section {
    border-bottom: 1px solid var(--border);
    background: var(--bg-alt);
  }
  h2.titulo {
    margin-bottom: 40px;
  }
  .grid {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: 20px;
    align-items: stretch;
  }
  .mapa {
    align-self: start;
    background: var(--surface);
    border: 1px solid var(--border);
  }
  .mapa-marco { aspect-ratio: 4 / 3; background: var(--bg-alt); }
  .mapa iframe { display: block; width: 100%; height: 100%; border: 0; }
  .mapa-pie { display: flex; align-items: center; justify-content: space-between; gap: 16px; padding: 20px 22px; }
  .preview-nombre { font: 32px/1 var(--font-display); }
  .ruta { flex-shrink: 0; padding: 12px 14px; background: var(--acc); color: var(--accInk); text-decoration: none; font: 11px/1.2 var(--font-mono); }
  .ruta:focus-visible { outline: 2px solid var(--text); outline-offset: 3px; }
  .cards {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .card {
    background: var(--surface);
    border: 1px solid var(--border);
    padding: 20px 22px;
  }
  .card:hover {
    border-color: var(--border-strong);
  }
  .card[aria-pressed="true"] { border-color: var(--acc); }
  .selector { display: block; width: 100%; color: var(--text); text-align: left; cursor: pointer; }
  .selector:focus-visible { outline: 2px solid var(--acc); outline-offset: 3px; }
  .selector[aria-pressed="true"] .nombre { color: var(--acc); }
  .cabecera {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 8px;
  }
  .nombre {
    font-family: var(--font-display);
    font-size: 24px;
    line-height: 1;
  }
  .ideal {
    display: block;
    font-size: 13px;
    color: var(--muted);
    line-height: 1.6;
  }
  @media (max-width: 859px) {
    .grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
